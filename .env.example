# ==============================================================================
# Latyr API — Example Environment Configuration Template (.env.example - Tracked)
# ==============================================================================

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=latyr_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/latyr_db

# ------------------------------------------------------------------------------
# Live External API Keys (Fill in your actual keys in .env)
# ------------------------------------------------------------------------------

# 1. Apify API Token (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=

# 2. Google Gemini AI API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 3. Firebase Admin SDK Service Account JSON Path
FIREBASE_CONFIG_PATH=

# 4. TMDB API Key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# 5. GitHub Personal Access Token (https://github.com/settings/tokens)
GITHUB_API_TOKEN=

# 6. RevenueCat Webhook Secret
REVENUECAT_WEBHOOK_SECRET=rc_webhook_secret_dev_123
