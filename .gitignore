# ==============================================================================
# Latyr Monorepo Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (Never commit credentials or tokens)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!*.env.example
*.key
*.pem
*.cer
*.crt
*.p12
*.pfx
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
firebase-adminsdk*.json
client_secret*.json
service-account*.json
credentials.json
token.json
tokens.json
secrets.json
secrets.yml
secrets.yaml

# ------------------------------------------------------------------------------
# 2. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 3. IDEs & Editors
# ------------------------------------------------------------------------------
# JetBrains / IntelliJ IDEA / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ------------------------------------------------------------------------------
# 4. Flutter / Dart (latyr-app)
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
**/doc/api/

# Android
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/gradle/wrapper/gradle-wrapper.jar

# iOS
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/flutter_assets/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Runner.xcworkspace/xcuserdata/
**/ios/Runner.xcodeproj/xcuserdata/
**/ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json
migrate_working_dir/

# ------------------------------------------------------------------------------
# 5. Java / Spring Boot / Maven (latyr-api)
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ------------------------------------------------------------------------------
# 6. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.swo
