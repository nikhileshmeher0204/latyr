# ==============================================================================
# Latyr API — Local Environment Template (.env.local.example - Tracked)
# ==============================================================================
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Local Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=latyr_db
DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/latyr_db

# Google Cloud Vertex AI & Firebase
FIREBASE_CONFIG_PATH=
GCP_PROJECT_ID=latyr-prod
GCP_LOCATION=us-central1
VERTEX_AI_MODEL_NAME=gemini-1.5-flash

# External API Keys
APIFY_API_TOKEN=
REVENUECAT_WEBHOOK_SECRET=rc_webhook_secret_dev_123
