# ==============================================================================
# Latyr API — Production Environment Template (.env.prod.example - Tracked)
# ==============================================================================
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Production Configuration
DB_HOST=prod-db.latyr.internal
DB_PORT=5432
DB_NAME=latyr_prod_db
DB_USERNAME=latyr_prod_user
DB_PASSWORD=your_prod_db_password
SPRING_DATASOURCE_URL=jdbc:postgresql://prod-db.latyr.internal:5432/latyr_prod_db

# External API Keys (Production)
APIFY_API_TOKEN=
GEMINI_API_KEY=
FIREBASE_CONFIG_PATH=/etc/secrets/firebase-service-account-prod.json
TMDB_API_KEY=
GITHUB_API_TOKEN=
REVENUECAT_WEBHOOK_SECRET=
