# ==============================================================================
# Latyr API — UAT Environment Template (.env.uat.example - Tracked)
# ==============================================================================
SPRING_PROFILES_ACTIVE=uat

# PostgreSQL UAT Configuration
DB_HOST=uat-db.latyr.internal
DB_PORT=5432
DB_NAME=latyr_uat_db
DB_USERNAME=latyr_uat_user
DB_PASSWORD=your_uat_db_password
SPRING_DATASOURCE_URL=jdbc:postgresql://uat-db.latyr.internal:5432/latyr_uat_db

# Google Cloud Vertex AI & Firebase
FIREBASE_CONFIG_PATH=/etc/secrets/firebase-service-account-uat.json
GCP_PROJECT_ID=latyr-uat
GCP_LOCATION=us-central1
VERTEX_AI_MODEL_NAME=gemini-1.5-flash

# External API Keys (UAT)
APIFY_API_TOKEN=
TMDB_API_KEY=
GITHUB_API_TOKEN=
REVENUECAT_WEBHOOK_SECRET=
