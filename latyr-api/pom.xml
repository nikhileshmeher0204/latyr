<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.4</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.latyr</groupId>
	<artifactId>latyr-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>latyr-api</name>
	<description>Latyr API Orchestration Backend</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter</artifactId>
			<version>3.0.3</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.firebase</groupId>
			<artifactId>firebase-admin</artifactId>
			<version>9.4.3</version>
		</dependency>
		<dependency>
			<groupId>com.google.genai</groupId>
			<artifactId>google-genai</artifactId>
			<version>0.7.0</version>
		</dependency>
		<dependency>
			<groupId>com.google.cloud</groupId>
			<artifactId>google-cloud-core</artifactId>
			<version>2.54.2</version>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>**/*service-account*.json</exclude>
					<exclude>**/*service_account*.json</exclude>
					<exclude>**/*serviceAccount*.json</exclude>
					<exclude>**/*adminsdk*.json</exclude>
					<exclude>**/google-services.json</exclude>
					<exclude>**/GoogleService-Info.plist</exclude>
					<exclude>**/client_secret*.json</exclude>
					<exclude>**/token.json</exclude>
					<exclude>**/tokens.json</exclude>
					<exclude>**/secrets.json</exclude>
					<exclude>**/secrets.yml</exclude>
					<exclude>**/secrets.yaml</exclude>
					<exclude>**/*.jks</exclude>
					<exclude>**/*.p8</exclude>
					<exclude>**/local.properties</exclude>
					<exclude>**/application-local*.yml</exclude>
					<exclude>**/application-local*.yaml</exclude>
					<exclude>**/*credentials*.json</exclude>
					<exclude>**/.env*</exclude>
					<exclude>**/*.key</exclude>
					<exclude>**/*.pem</exclude>
					<exclude>**/*.keystore</exclude>
					<exclude>**/*.p12</exclude>
					<exclude>**/*.pfx</exclude>
					<exclude>**/application-local*.properties</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<executions>
					<execution>
						<id>remove-stale-packaged-credentials</id>
						<phase>initialize</phase>
						<goals><goal>clean</goal></goals>
						<configuration>
							<excludeDefaultDirectories>true</excludeDefaultDirectories>
							<filesets>
								<fileset>
									<directory>${project.build.outputDirectory}</directory>
									<followSymlinks>false</followSymlinks>
									<includes>
										<include>**/*service-account*.json</include>
										<include>**/*service_account*.json</include>
										<include>**/*serviceAccount*.json</include>
										<include>**/*adminsdk*.json</include>
										<include>**/google-services.json</include>
										<include>**/GoogleService-Info.plist</include>
										<include>**/client_secret*.json</include>
										<include>**/token.json</include>
										<include>**/tokens.json</include>
										<include>**/secrets.json</include>
										<include>**/secrets.yml</include>
										<include>**/secrets.yaml</include>
										<include>**/*.jks</include>
										<include>**/*.p8</include>
										<include>**/local.properties</include>
										<include>**/application-local*.yml</include>
										<include>**/application-local*.yaml</include>
										<include>**/*credentials*.json</include>
										<include>**/.env*</include>
										<include>**/*.key</include>
										<include>**/*.pem</include>
										<include>**/*.keystore</include>
										<include>**/*.p12</include>
										<include>**/*.pfx</include>
										<include>**/application-local*.properties</include>
									</includes>
								</fileset>
							</filesets>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<!-- Also block credentials left in target/classes by earlier builds. -->
					<excludes>
						<exclude>**/*service-account*.json</exclude>
						<exclude>**/*service_account*.json</exclude>
						<exclude>**/*serviceAccount*.json</exclude>
						<exclude>**/*adminsdk*.json</exclude>
						<exclude>**/google-services.json</exclude>
						<exclude>**/GoogleService-Info.plist</exclude>
						<exclude>**/client_secret*.json</exclude>
						<exclude>**/token.json</exclude>
						<exclude>**/tokens.json</exclude>
						<exclude>**/secrets.json</exclude>
						<exclude>**/secrets.yml</exclude>
						<exclude>**/secrets.yaml</exclude>
						<exclude>**/*.jks</exclude>
						<exclude>**/*.p8</exclude>
						<exclude>**/local.properties</exclude>
						<exclude>**/application-local*.yml</exclude>
						<exclude>**/application-local*.yaml</exclude>
						<exclude>**/*credentials*.json</exclude>
						<exclude>**/.env*</exclude>
						<exclude>**/*.key</exclude>
						<exclude>**/*.pem</exclude>
						<exclude>**/*.keystore</exclude>
						<exclude>**/*.p12</exclude>
						<exclude>**/*.pfx</exclude>
						<exclude>**/application-local*.properties</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
